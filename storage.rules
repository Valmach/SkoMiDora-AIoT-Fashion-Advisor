rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for wardrobe item images
    match /public_wardrobe_items/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Writes should only happen from the trusted backend
    }

    // Example for user-specific private files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
