rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /public_wardrobe_items/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
