{
  "projects": {
    "default": "styleai-footwear"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB"
    }
  },
  "apphosting": {
    "backendId": "sk-styleai-footwear-us-cen1",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "alwaysDeployFromSource": false,
    "environment": {
      "BUILD_COMMAND": "npm run build"
    }
  }
}