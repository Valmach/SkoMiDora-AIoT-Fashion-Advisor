
"use server";
/**
 * @fileOverview Processes user feedback on an outfit recommendation and generates a follow-up AI response.
 *
 * - processOutfitFeedback - A function that processes user feedback.
 * - ProcessOutfitFeedbackInput - The input type for the processOutfitFeedback function.
 * - ProcessOutfitFeedbackOutput - The return type for the processOutfitFeedback function.
 */

import { ai } from "@/ai/genkit";
import type { 
    ProcessOutfitFeedbackInput, 
    ProcessOutfitFeedbackOutput, 
    OutfitForFeedbackAction, 
    EventDetailsForFeedbackAction 
} from "@/types";
import { 
    ProcessOutfitFeedbackInputSchema, 
    ProcessOutfitFeedbackOutputSchema 
} from "@/types/schemas";

// Type alias for external usage
export type OutfitForFeedback = OutfitForFeedbackAction;
export type EventDetailsForFeedback = EventDetailsForFeedbackAction;

export async function processOutfitFeedback(
  input: ProcessOutfitFeedbackInput,
): Promise<ProcessOutfitFeedbackOutput> {
  return processOutfitFeedbackFlow(input);
}

const prompt = ai.definePrompt({
  name: "processOutfitFeedbackPrompt",
  input: { schema: ProcessOutfitFeedbackInputSchema },
  output: { schema: ProcessOutfitFeedbackOutputSchema },
  model: "googleai/gemini-2.5-flash-latest",
  prompt: `You are a sophisticated and empathetic AI personal stylist, SkoMiDora.
  A user has just provided feedback on an outfit you previously recommended for an event.
  Your goal is to generate a concise, helpful, and context-aware 'followUpMessage' in British English.
  This message will be displayed directly to the user. Ensure your follow-up message uses contemporary, empathetic, and sophisticated fashion language suitable for Gen X, Y, and Z.

  User's Style DNA: {{{userStyleDNA}}}

  Event Details:
  - Name: {{{eventDetails.eventName}}}
  - Type: {{{eventDetails.eventType}}}
  {{#if eventDetails.eventLocation}}- Location: {{{eventDetails.eventLocation}}}{{/if}}

  Original Outfit Recommendation:
  - Chosen Shoe: {{{outfitDetails.chosenShoe}}}
  - Description: {{{outfitDetails.outfitDescription}}}
  - Your Reasoning: {{{outfitDetails.reasoning}}}

  User's Action: {{{userAction}}}
  {{#if userReason}}User's Reason: {{{userReason}}}{{/if}}

  Based on the user's action and (if provided) their reason:

  If the user 'accepted' the outfit:
  - Acknowledge their choice positively.
  - Offer a brief, insightful styling tip related to the chosen outfit or event (e.g., "Excellent choice! That ensemble will be perfect for the {{{eventDetails.eventType}}}. Perhaps consider a classic trench coat if the evening gets cooler." or "Wonderful! Those {{{outfitDetails.chosenShoe}}} will truly complete the look. Enjoy the {{{eventDetails.eventName}}}!").
  - Keep it concise (1-2 sentences).

  If the user 'rejected' the outfit:
  - Acknowledge their feedback gracefully.
  - If they provided a reason, briefly reflect on it.
  - Offer to help find alternatives, e.g., "Thank you for your feedback. I understand this wasn't quite right. I'll strive to find better alternatives for you next time." or "Noted. I'll take your preference for {{{userReason}}} into account for future suggestions. Would you like me to try and find another option for the {{{eventDetails.eventName}}}?"
  - Keep it concise and helpful (1-2 sentences).

  If the user 'modified' or indicated a desire to modify the outfit:
  - Acknowledge their intent positively.
  - Briefly suggest you're ready to help with alternatives if they'd like to explore other specific items, or note that you'll learn from their preference. E.g., "Understood! Personal touches make all the difference. I'll remember your preference for adjustments." or "Great! I'm here to help if you'd like to explore different items to perfect this look for the {{{eventDetails.eventName}}}."
  - Keep it concise (1-2 sentences).

  CRITICAL: The 'followUpMessage' MUST be a single, friendly, plain text paragraph in British English.
  It should be conversational and reflect your persona as a helpful AI stylist using modern fashion language.
  Do NOT output JSON.
  `,
});

const processOutfitFeedbackFlow = ai.defineFlow(
  {
    name: "processOutfitFeedbackFlow",
    inputSchema: ProcessOutfitFeedbackInputSchema,
    outputSchema: ProcessOutfitFeedbackOutputSchema,
  },
  async (input: ProcessOutfitFeedbackInput) => {
    const { output } = await prompt(input);
    if (
      !output ||
      typeof output.followUpMessage !== "string" ||
      output.followUpMessage.trim().length < 10
    ) {
      // Fallback in case the AI fails to produce a suitable message
      let fallbackMessage = "Thank you for your feedback!";
      if (input.userAction === "accepted")
        fallbackMessage = "Great choice! I'm glad you liked it.";
      if (input.userAction === "rejected")
        fallbackMessage =
          "Thanks for letting me know. I'll try to do better next time.";
      if (input.userAction === "modified")
        fallbackMessage =
          "Understood! Feel free to make any adjustments you like.";
      console.warn(
        "AI did not return suitable plain text for followUpMessage, using fallback. AI Output:",
        output,
      );
      return { followUpMessage: fallbackMessage };
    }
    return output;
  },
);
